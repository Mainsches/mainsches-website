# --- Pilot / contact form mail adapter -------------------------------------
# The same variable names were already used by the previous api/contact.js
# Vercel serverless function, so a configured Vercel project keeps working
# without any changes. When these are missing, the form API responds with
# 503 { configured: false } and the UI shows an honest mailto fallback
# instead of a fake success message.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=change-me

# Recipient inbox for pilot program / partner / investor requests.
CONTACT_TO=contact@mainsches.com
